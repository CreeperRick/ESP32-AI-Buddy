# Copy to .env or let setup.py generate this file.

HOST=0.0.0.0
PORT=8080

# Shared token. Leave empty to disable auth (LAN only).
API_TOKEN=

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# tiny.en / base.en / small.en / distil-small.en
WHISPER_MODEL=base.en
# auto | cpu | cuda
WHISPER_DEVICE=auto

PIPER_VOICE=en_US-lessac-medium
PIPER_VOICES_DIR=voices

# Keep spoken replies short for the Cardputer screen and speaker.
SYSTEM_PROMPT=You are Buddy, a helpful local AI on a tiny M5Stack Cardputer ADV. Reply in 1-3 short spoken sentences. No markdown, no lists, no emoji unless asked.

MAX_HISTORY=8
MAX_REPLY_CHARS=400
